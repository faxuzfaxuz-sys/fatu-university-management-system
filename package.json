{
  "name": "nextjs-postgresql-template",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "desktop:build": "npm run build && electron-builder --win nsis --x64",
    "desktop:build:dir": "npm run build && electron-builder --dir --win --x64"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.45.0",
    "next": "^16.3.4",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "uz.fatu.university.portal",
    "productName": "FATU University Portal",
    "artifactName": "FATU-University-Portal-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "app/.next"
      },
      {
        "from": "runtime_node_modules/node_modules",
        "to": "app/node_modules"
      },
      {
        "from": "package.json",
        "to": "app/package.json"
      },
      {
        "from": "next.config.ts",
        "to": "app/next.config.ts"
      },
      {
        "from": "desktop/config.example.env",
        "to": "config.example.env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FATU University Portal"
    }
  }
}
